#!/bin/sh
# purge : il reste des préférences dans ~/.config à la charge de l'utilisateur,
# comme le veut la règle Debian — un paquet ne supprime pas les données d'une
# session, même après purge.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  for cmd in gtk-update-icon-cache update-desktop-database; do
    if command -v "$cmd" >/dev/null 2>&1; then
      case "$cmd" in
        gtk-update-icon-cache)
          gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
          ;;
        update-desktop-database)
          update-desktop-database -q /usr/share/applications 2>/dev/null || true
          ;;
      esac
    fi
  done
fi

exit 0

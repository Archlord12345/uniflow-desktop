# Dépendances d'exécution du bundle Linux — source unique pour le .deb, le .rpm
# et l'AppImage.
#
# Pourquoi pas `dpkg-shlibdeps` : la liste générée dépend des paquets installés
# sur le runner à l'instant T et bouge sans qu'on le décide. Une liste relue par
# un humain, et **vérifiée contre `ldd` à chaque build** par
# tool/check-linux-deps.sh, vaut mieux qu'une liste produite automatiquement la
# veille d'une publication.
#
# Les noms visent Ubuntu 24.04 (Noble) et Debian 13 (Trixie) pour le .deb,
# Fedora 40+ pour le .rpm : ce sont les distributions où existent les paquets
# portant le suffixe « t64 » de la transition time_t 64 bits.

# ---- Debian / Ubuntu --------------------------------------------------------
# Uniquement ce que le binaire lie directement ou charge explicitement ;
# `tool/check-linux-deps.sh` refuse tout soname dont le fournisseur n'est pas
# dans cette liste ni dans sa fermeture transitive.
DEB_DEPENDS="libgstreamer-gl1.0-0
libgstreamer-plugins-base1.0-0
libgstreamer1.0-0
libgtk-3-0t64
libpulse0
libgcc-s1
libstdc++6
libwebkit2gtk-4.1-0
libx11-6
xdg-utils
zlib1g"

# Chargés à l'exécution sans être liés au binaire : codecs et greffons GStreamer
# que la visioconférence réclame au démarrage d'un flux.
DEB_RECOMMENDS="gstreamer1.0-plugins-good
gstreamer1.0-plugins-bad
gstreamer1.0-libav
hicolor-icon-theme
shared-mime-info"

# ---- Fedora / RPM -----------------------------------------------------------
RPM_DEPENDS="gstreamer1
gstreamer1-plugins-base
gstreamer1-plugins-good
gstreamer1-plugins-bad-free
gstreamer1-libav
gtk3
libgcc
libstdc++
mesa-libgbm
pulseaudio-libs
webkit2gtk4.1
xdg-utils
zlib"
# ---- Sonames critiques ------------------------------------------------------
# Sans eux la fenêtre ne s'ouvre même pas : le contrôle échoue s'ils ne se
# résolvent pas sur la machine de build.
CRITICAL_SONAMES="libgtk-3.so.0
libwebkit2gtk-4.1.so.0
libjavascriptcoregtk-4.1.so.0
libpulse.so.0
libgstreamer-1.0.so.0
libgstbase-1.0.so.0
libEGL.so.1
libGL.so.1
libstdc++.so.6
libsoup-3.0.so.0
libsqlite3.so.0"

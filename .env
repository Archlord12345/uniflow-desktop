# Appwrite Cloud (région Francfort) — projet « uniflow ».
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=uniflow
APPWRITE_DATABASE_ID=uniflow
# Offre gratuite : un seul bucket pour documents, photos de profil et pièces jointes.
APPWRITE_STORAGE_BUCKET_ID=uniflow_assets
APPWRITE_AVATAR_BUCKET_ID=uniflow_assets
APPWRITE_CHAT_FILES_BUCKET_ID=uniflow_assets
# Une seule Function HTTP (« uniflow-api ») aiguille les services sur le chemin appelé.
APPWRITE_API_FUNCTION_ID=uniflow-api
# Client web public : liens « s'inscrire sur le web » et page de réinitialisation
# du mot de passe (Appwrite y renvoie avec userId + secret).
APP_WEB_URL=https://uniflow.kernelforge.codes

# --- Visioconférence embarquée -------------------------------------------
# Collection servant d'annuaire aux réunions (facultatif : à défaut,
# « conference_rooms » est utilisée).
# APPWRITE_CONFERENCE_COLLECTION_ID=conference_rooms
#
# Chemin du binaire livekit-server installé sur cette machine. À renseigner
# s'il n'est pas dans le PATH ni dans un emplacement standard (/usr/local/bin,
# /usr/bin, ~/.local/bin, /opt/livekit).
# LIVEKIT_SERVER_PATH=/usr/local/bin/livekit-server
#
# Flutter déclare ce fichier comme asset : tout ce qui s'y trouve est embarqué
# en clair dans le binaire. N'y mettez jamais une clé d'API Appwrite serveur —
# les opérations privilégiées passent par les Functions Appwrite.
